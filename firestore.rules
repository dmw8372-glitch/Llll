rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validator
    function isValidUserProfile(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.id == request.auth.uid
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 30
        && data.level is int
        && data.level >= 1
        && data.score is int
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 30))
        && (!('exp' in data) || (data.exp is int && data.exp >= 0))
        && (!('totalGames' in data) || (data.totalGames is int && data.totalGames >= 0))
        && (!('wins' in data) || (data.wins is int && data.wins >= 0))
        && (!('winRate' in data) || data.winRate is number)
        && (!('highestRank' in data) || (data.highestRank is string && data.highestRank.size() <= 50))
        && (!('currentStreak' in data) || (data.currentStreak is int && data.currentStreak >= 0))
        && (!('maxStreak' in data) || (data.maxStreak is int && data.maxStreak >= 0))
        && (!('rankPoints' in data) || (data.rankPoints is int && data.rankPoints >= 0))
        && (!('tier' in data) || (data.tier is string && data.tier.size() <= 30))
        && (!('rankedGames' in data) || (data.rankedGames is int && data.rankedGames >= 0))
        && (!('rankedWins' in data) || (data.rankedWins is int && data.rankedWins >= 0))
        && (!('rankedLosses' in data) || (data.rankedLosses is int && data.rankedLosses >= 0));
    }

    // 4. User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId);
    }

    // 5. Public Rankings Collection
    match /rankings/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidId(userId);
    }
  }
}
